/* subpage1/pages/horoscope/index.wxss */
/* 每日星座运势页面样式 */

.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #F8A7C4 0%, #E879A6 100%);
  padding-bottom: 40rpx;
  /* 🔑 确保容器可以滚动并触发事件 */
  overflow-y: auto;
  -webkit-overflow-scrolling: touch; /* iOS 平滑滚动 */
}

/* ========== 顶部导航栏 ========== */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10rpx);
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 40rpx;
  color: #fff;
}

.page-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.date-display {
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
}

.date-text {
  font-size: 24rpx;
  color: #fff;
}

/* ========== 星座选择器 ========== */
/* 已移除，改为用户专属展示 */

/* ========== 未设置星座提示 ========== */
.not-set-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 50rpx;
  animation: fade-in 0.6s ease;
}

@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

.not-set-icon {
  font-size: 120rpx;
  margin-bottom: 40rpx;
  animation: float-bounce 3s ease-in-out infinite;
  filter: drop-shadow(0 8rpx 24rpx rgba(0, 0, 0, 0.2));
}

@keyframes float-bounce {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-20rpx) scale(1.05); }
}

.not-set-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.not-set-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  text-align: center;
  line-height: 1.8;
  margin-bottom: 50rpx;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.1);
}

.set-constellation-btn {
  padding: 24rpx 70rpx;
  background: linear-gradient(135deg, #fff 0%, #f8f9ff 100%);
  border-radius: 50rpx;
  color: #F48FB1;
  font-size: 30rpx;
  font-weight: bold;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.2),
              0 4rpx 12rpx rgba(244, 143, 177, 0.3);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
}

.set-constellation-btn:active {
  transform: scale(0.95);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

/* ========== 用户星座标识 - 沉浸式设计 ========== */
.user-constellation-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 30rpx;
  position: relative;
}

.constellation-badge {
  position: relative;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.25) 0%, rgba(255, 255, 255, 0.15) 100%);
  backdrop-filter: blur(20rpx);
  border-radius: 50rpx;
  padding: 20rpx 40rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.3);
  animation: badge-appear 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes badge-appear {
  from {
    opacity: 0;
    transform: translateY(-20rpx) scale(0.9);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.constellation-symbol {
  font-size: 64rpx;
  margin-right: 20rpx;
  filter: drop-shadow(0 4rpx 12rpx rgba(0, 0, 0, 0.2));
  animation: symbol-float 3s ease-in-out infinite;
}

@keyframes symbol-float {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-8rpx) rotate(5deg); }
}

.constellation-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  letter-spacing: 2rpx;
}

.constellation-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.15);
  letter-spacing: 1rpx;
}

/* ========== 加载状态 ========== */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 70rpx;
  height: 70rpx;
  border: 5rpx solid rgba(255, 255, 255, 0.2);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  box-shadow: 0 0 20rpx rgba(255, 255, 255, 0.3);
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.1);
}

/* ========== 内容区域 ========== */
.content-area {
  padding: 20rpx 30rpx;
  /* 🔑 确保可以自然滚动 */
  overflow-y: auto;
  -webkit-overflow-scrolling: touch; /* iOS 平滑滚动 */
}

/* ========== 卡片通用样式 ========== */
.section-card {
  background: #fff;
  border-radius: 28rpx;
  margin-bottom: 24rpx; /* 🔑 优化间距，减少拥挤感 */
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.12),
              0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  animation: card-slide-up 0.5s cubic-bezier(0.4, 0, 0.2, 1) backwards;
  position: relative; /* 🔑 为滚动提示定位做准备 */
}

.section-card:nth-child(1) { animation-delay: 0.1s; }
.section-card:nth-child(2) { animation-delay: 0.2s; }
.section-card:nth-child(3) { animation-delay: 0.3s; }
.section-card:nth-child(4) { animation-delay: 0.4s; }

@keyframes card-slide-up {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.section-header {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.section-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.section-content {
  padding: 20rpx 30rpx; /* 🔑 略微减小内边距，节省空间 */
}

/* ========== L1: 星象解码 ========== */
.astro-section .astro-text {
  font-size: 26rpx;
  line-height: 1.8;
  color: #666;
}

/* ========== L2: 今日指引 + 运势评分（整合区域） ========== */
.guide-section {
  background: linear-gradient(135deg, #fff 0%, #f8f9ff 100%);
}

.guide-text {
  font-size: 30rpx; /* 🔑 略微减小字体，节省空间 */
  line-height: 1.8;
  color: #333;
  font-weight: 500;
  display: block;
  margin-bottom: 28rpx; /* 🔑 今日指引与运势评分的间距 */
}

/* 🔑 整合的运势评分容器 */
.fortune-scores-integrated {
  margin-top: 8rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(248, 167, 196, 0.15); /* 🔑 淡粉色分隔线 */
}

/* ========== L3: AI 暖心建议 ========== */
.advice-section {
  border: 2rpx solid #FFD93D;
  background: linear-gradient(135deg, #fff 0%, #fff9e6 100%);
}

.advice-text {
  font-size: 27rpx; /* 🔑 略微减小字体，节省空间 */
  line-height: 1.8;
  color: #555;
  margin-bottom: 24rpx;
}

/* 宜忌事项网格 */
.dos-donts-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx; /* 🔑 减小间距，节省空间 */
  margin-top: 20rpx;
}

.dos-item {
  padding: 16rpx; /* 🔑 减小内边距 */
  border-radius: 16rpx;
}

.dos-item.positive {
  background: rgba(82, 196, 26, 0.1);
  border: 1rpx solid rgba(82, 196, 26, 0.3);
}

.dos-item.negative {
  background: rgba(255, 77, 79, 0.1);
  border: 1rpx solid rgba(255, 77, 79, 0.3);
}

.dos-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.dos-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.dos-label {
  font-size: 26rpx;
  font-weight: bold;
}

.tags-container {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tag {
  font-size: 22rpx;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
}

.positive-tag {
  background: rgba(82, 196, 26, 0.2);
  color: #52c41a;
}

.negative-tag {
  background: rgba(255, 77, 79, 0.2);
  color: #ff4d4f;
}


.fortune-item {
  margin-bottom: 28rpx; /* 🔑 优化间距，减少拥挤感 */
}

.fortune-item:last-child {
  margin-bottom: 0;
}

.fortune-label-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.fortune-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.fortune-label {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.fortune-score {
  font-size: 36rpx;
  font-weight: bold;
  transition: all 0.3s ease;
}

.fortune-score.low {
  background: linear-gradient(135deg, #a78bfa, #8b5cf6);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  color: transparent;
  animation: score-appear 0.5s ease backwards;
}

.fortune-score.medium {
  background: linear-gradient(135deg, #8b5cf6, #7c3aed);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  color: transparent;
  animation: score-appear 0.5s ease backwards;
}

.fortune-score.high {
  background: linear-gradient(135deg, #7c3aed, #6d28d9);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  color: transparent;
  animation: score-pop 0.6s cubic-bezier(0.4, 0, 0.2, 1) backwards;
}

@keyframes score-appear {
  from {
    opacity: 0;
    transform: scale(0.8);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes score-pop {
  0% {
    opacity: 0;
    transform: scale(0.5);
  }
  50% {
    transform: scale(1.2);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

/* 进度条 */
.progress-bar-bg {
  height: 14rpx;
  background: linear-gradient(90deg, #f0f0f0 0%, #e8e8e8 100%);
  border-radius: 7rpx;
  overflow: hidden;
  box-shadow: inset 0 1rpx 3rpx rgba(0, 0, 0, 0.1);
}

.progress-bar-fill {
  height: 100%;
  min-width: 2rpx; /* 🔑 临时调试：确保即使宽度很小也能看到 */
  border-radius: 7rpx;
  transition: width 1s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
  display: block; /*  确保元素可见 */
}

.progress-bar-fill::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255, 255, 255, 0.4) 50%,
    transparent 100%
  );
  animation: shimmer 2s infinite;
}

@keyframes shimmer {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

.progress-bar-fill.low {
  background: linear-gradient(90deg, #a78bfa, #8b5cf6);
}

.progress-bar-fill.medium {
  background: linear-gradient(90deg, #8b5cf6, #7c3aed);
}

.progress-bar-fill.high {
  background: linear-gradient(90deg, #7c3aed, #6d28d9);
}

/* ========== 滚动提示 ========== */
.scroll-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0 16rpx;
  margin-top: 16rpx;
  border-top: 1rpx solid rgba(248, 167, 196, 0.15);
  animation: hint-fade-in 0.6s ease backwards, hint-bounce 2s ease-in-out infinite 1s;
}

@keyframes hint-fade-in {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes hint-bounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8rpx);
  }
}

.scroll-arrow {
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-top: 16rpx solid #F8A7C4;
  margin-bottom: 12rpx;
  filter: drop-shadow(0 2rpx 8rpx rgba(248, 167, 196, 0.3));
  animation: arrow-pulse 1.5s ease-in-out infinite;
}

@keyframes arrow-pulse {
  0%, 100% {
    opacity: 0.6;
    transform: scale(1);
  }
  50% {
    opacity: 1;
    transform: scale(1.1);
  }
}

.scroll-text {
  font-size: 24rpx;
  color: #F8A7C4;
  font-weight: 500;
  letter-spacing: 1rpx;
  text-shadow: 0 1rpx 4rpx rgba(248, 167, 196, 0.2);
}

/* ========== 错误提示 ========== */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 30rpx;
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.error-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 30rpx;
}

.retry-btn {
  padding: 20rpx 60rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 40rpx;
  color: #fff;
  font-size: 28rpx;
}

/* ========== 分享按钮样式 ========== */
.share-horoscope-btn-wrapper {
  margin: 30rpx 30rpx 0;
  animation: card-slide-up 0.5s cubic-bezier(0.4, 0, 0.2, 1) backwards;
  animation-delay: 0.5s;
}

.share-horoscope-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #F8A7C4 0%, #E879A6 100%);
  border: none;
  border-radius: 44rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(248, 167, 196, 0.4);
  transition: all 0.2s ease;
}

.share-horoscope-btn::after {
  border: none;
}

.share-horoscope-btn:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 16rpx rgba(248, 167, 196, 0.3);
}

.share-icon {
  margin-right: 8rpx;
  font-size: 32rpx;
}

/* 隐藏的分享画布 */
.share-canvas-hidden {
  position: fixed;
  top: -9999rpx;
  left: -9999rpx;
  width: 750px;
  height: 1334px;
}
