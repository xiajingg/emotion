<!-- subpage1/pages/horoscope/index.wxml -->
<!-- 每日星座运势页面 -->
<view class="container" bindscroll="onPageScroll">

  <!-- 未设置星座提示 -->
  <view class="not-set-container" wx:if="{{notSetConstellation}}">
    <view class="not-set-icon">✨</view>
    <text class="not-set-title">请先设置您的星座</text>
    <text class="not-set-desc">设置星座后，即可查看专属的每日运势</text>
    <button class="set-constellation-btn {{isNavigatingToSetConstellation ? 'tap-disabled' : ''}}" bindtap="goToSetConstellation" disabled="{{isNavigatingToSetConstellation}}">去设置星座</button>
  </view>

  <!-- 用户星座标识 -->
  <view class="user-constellation-header" wx:if="{{!notSetConstellation && constellationName}}">
    <view class="constellation-badge">
      <text class="constellation-symbol">{{constellationIcon}}</text>
      <text class="constellation-name">{{constellationName}}</text>
    </view>
    <text class="constellation-subtitle">专属运势 · {{displayDate}}</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在获取星象数据...</text>
  </view>

  <!-- 内容区域 -->
  <view class="content-area" wx:if="{{!loading && horoscopeData}}">
    
    <!-- L1: 星象解码（默认展开，无折叠） -->
    <view class="section-card astro-section">
      <view class="section-header">
        <text class="section-icon">🔮</text>
        <text class="section-title">星象解码</text>
      </view>
      <view class="section-content">
        <text class="astro-text">{{horoscopeData.astroAnalysis}}</text>
      </view>
    </view>

    <!-- L2: 今日指引 + 三维运势仪表盘（整合为同一卡片） -->
    <view class="section-card guide-section">
      <view class="section-header">
        <text class="section-icon">🌟</text>
        <text class="section-title">今日指引</text>
      </view>
      <view class="section-content">
        <text class="guide-text">{{horoscopeData.content}}</text>
        
        <!-- 🔑 整合的运势评分区域 -->
        <view class="fortune-scores-integrated">
          
          <!-- 情感运势 -->
          <view class="fortune-item">
            <view class="fortune-label-row">
              <text class="fortune-icon">❤️</text>
              <text class="fortune-label">情感运势</text>
              <text class="fortune-score {{horoscopeData.loveFortuneClass}}">{{horoscopeData.loveFortune}}</text>
            </view>
            <view class="progress-bar-bg">
              <view 
                class="progress-bar-fill {{horoscopeData.loveFortuneClass}}" 
                style="{{'width:' + horoscopeData.loveFortune + '%'}}"
              ></view>
            </view>
          </view>

          <!-- 财富运势 -->
          <view class="fortune-item">
            <view class="fortune-label-row">
              <text class="fortune-icon">💰</text>
              <text class="fortune-label">财富运势</text>
              <text class="fortune-score {{horoscopeData.wealthFortuneClass}}">{{horoscopeData.wealthFortune}}</text>
            </view>
            <view class="progress-bar-bg">
              <view 
                class="progress-bar-fill {{horoscopeData.wealthFortuneClass}}" 
                style="{{'width:' + horoscopeData.wealthFortune + '%'}}"
              ></view>
            </view>
          </view>

          <!-- 事业运势 -->
          <view class="fortune-item">
            <view class="fortune-label-row">
              <text class="fortune-icon">💼</text>
              <text class="fortune-label">事业运势</text>
              <text class="fortune-score {{horoscopeData.careerFortuneClass}}">{{horoscopeData.careerFortune}}</text>
            </view>
            <view class="progress-bar-bg">
              <view 
                class="progress-bar-fill {{horoscopeData.careerFortuneClass}}" 
                style="{{'width:' + horoscopeData.careerFortune + '%'}}"
              ></view>
            </view>
          </view>

        </view>
      </view>
      
      <!-- 滚动提示（仅在小屏幕显示） -->
      <view class="scroll-hint" wx:if="{{showScrollHint}}">
        <view class="scroll-arrow"></view>
        <text class="scroll-text">上滑查看更多</text>
      </view>
    </view>

    <!-- L3: AI 暖心建议（重点强调） -->
    <view class="section-card advice-section">
      <view class="section-header">
        <text class="section-icon">💝</text>
        <text class="section-title">AI 暖心建议</text>
      </view>
      <view class="section-content">
        <text class="advice-text">{{horoscopeData.aiAdvice}}</text>
        
        <!-- 宜忌事项 -->
        <view class="dos-donts-grid" wx:if="{{parsedDosAndDonts}}">
          <view class="dos-item positive">
            <view class="dos-header">
              <text class="dos-icon">✅</text>
              <text class="dos-label">宜</text>
            </view>
            <view class="tags-container">
              <text wx:for="{{parsedDosAndDonts.dos}}" wx:key="*this" class="tag positive-tag">{{item}}</text>
            </view>
          </view>
          <view class="dos-item negative">
            <view class="dos-header">
              <text class="dos-icon">❌</text>
              <text class="dos-label">忌</text>
            </view>
            <view class="tags-container">
              <text wx:for="{{parsedDosAndDonts.donts}}" wx:key="*this" class="tag negative-tag">{{item}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 分享按钮 -->
    <view class="share-horoscope-btn-wrapper" wx:if="{{horoscopeData}}">
      <button class="share-horoscope-btn {{isSharingHoroscope ? 'tap-disabled' : ''}}" bindtap="shareHoroscopeCard" disabled="{{isSharingHoroscope}}">
        <text class="share-icon">📤</text>
        <text>分享今日运势</text>
      </button>
    </view>

  </view>

  <!-- 错误提示 -->
  <view class="error-container" wx:if="{{errorMsg}}">
    <text class="error-icon">⚠️</text>
    <text class="error-text">{{errorMsg}}</text>
    <button class="retry-btn {{loading ? 'tap-disabled' : ''}}" bindtap="loadHoroscope" disabled="{{loading}}">重新加载</button>
  </view>

  <!-- 隐藏的分享画布 -->
  <canvas id="horoscopeShareCanvas" class="share-canvas-hidden" type="2d"></canvas>

</view>
