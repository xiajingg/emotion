<view class="page">
  <view class="header">
    <text class="title">话术收藏</text>
    <text class="subtitle">保存那些下次还能直接用的话。</text>
  </view>

  <view class="empty" wx:if="{{!loading && favorites.length === 0}}">
    <text class="empty-title">还没有收藏</text>
    <text class="empty-desc">在首页生成回复后，点“收藏”就会出现在这里。</text>
  </view>

  <view class="list" wx:else>
    <view class="card" wx:for="{{favorites}}" wx:key="id">
      <view class="meta">
        <text class="style">{{item.replyStyleText}}</text>
        <text class="date">{{item.createTimeText}}</text>
      </view>
      <text class="reply">{{item.replyText}}</text>
      <view class="actions">
        <button class="copy-btn" data-text="{{item.replyText}}" bindtap="copyReply">复制</button>
        <button class="delete-btn" data-id="{{item.id}}" bindtap="deleteFavorite">删除</button>
      </view>
    </view>
  </view>

  <view class="load-more" wx:if="{{hasMore && !loading}}" bindtap="loadMore">加载更多</view>
  <view class="loading" wx:if="{{loading}}">加载中...</view>
</view>
