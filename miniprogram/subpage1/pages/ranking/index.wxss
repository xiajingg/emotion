/* subpage1/pages/ranking/index.wxss */
/* 温暖治愈系样式 - 粉色渐变主题 */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #F8A7C4 0%, #E879A6 100%);
  padding: 30rpx;
  padding-bottom: 200rpx;
  display: flex;
  flex-direction: column;
}

.rank-title-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  backdrop-filter: blur(10px);
}

.rank-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #F48FB1;
}

.rank-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #636E72;
}

/* ---- 表格 ---- */
.table-wrap {
  flex: 1;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
  backdrop-filter: blur(10px);
}

.table {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.table-header {
  display: flex;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, rgba(244, 143, 177, 0.1) 0%, rgba(255, 182, 201, 0.1) 100%);
  font-size: 28rpx;
  color: #F48FB1;
  font-weight: 600;
  border-bottom: 2rpx solid rgba(244, 143, 177, 0.2);
}

.table-body {
  flex: 1;
  overflow-y: auto;
  max-height: calc(100vh - 400rpx);
}

.table-row {
  display: flex;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  font-size: 28rpx;
  color: #2D3436;
  transition: all 0.2s ease;
  align-items: center;
}

.table-row:last-child { border-bottom: none; }

.table-row:active {
  background: rgba(244, 143, 177, 0.05);
  transform: scale(0.99);
}

.table-row.highlight {
  background: linear-gradient(135deg, rgba(244, 143, 177, 0.1) 0%, rgba(255, 182, 201, 0.1) 100%);
  color: #F48FB1;
  font-weight: 600;
  border-left: 4rpx solid #F48FB1;
}

.table-row.highlight .col-val {
  color: #F48FB1;
  font-weight: 700;
}

.col-rank {
  width: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rank-badge {
  font-size: 32rpx;
  font-weight: 700;
  color: #B2BEC3;
  display: inline-block;
  min-width: 48rpx;
  text-align: center;
}

.rank-badge.gold {
  font-size: 40rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(255, 215, 0, 0.5));
}

.rank-badge.silver {
  font-size: 38rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(192, 192, 192, 0.5));
}

.rank-badge.bronze {
  font-size: 36rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(205, 127, 50, 0.5));
}

.col-user {
  flex: 1;
  padding-left: 16rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.col-val {
  width: 140rpx;
  text-align: right;
  font-weight: 600;
  color: #2D3436;
  font-size: 30rpx;
}

.empty-text {
  text-align: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: #B2BEC3;
  background: rgba(255, 255, 255, 0.5);
}

/* ---- 底部导航占位 ---- */
.tab-bar-placeholder {
  height: 120rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
