/* pages/answer-book/index.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #F8A7C4 0%, #E879A6 100%);
  padding: 40rpx 30rpx 180rpx;
}

/* 顶部标题区域 */
.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 20rpx;
}

.remaining-count {
  display: inline-block;
  background: rgba(255, 255, 255, 0.2);
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #fff;
}

.remaining-count .count {
  font-weight: bold;
  font-size: 32rpx;
  color: #FFD700;
}

/* 输入区域 */
.input-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.question-input {
  width: 100%;
  min-height: 200rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: #333;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

/* 按钮区域 */
.action-section {
  margin-bottom: 20rpx;
}

/* 分享卡片按钮区域（始终显示） */
.share-action-section {
  margin-bottom: 30rpx;
}

.btn-share-card {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #F48FB1 0%, #F9A8C5 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(244, 143, 177, 0.3);
  transition: all 0.2s ease;
}

.btn-share-card::after {
  border: none;
}

.btn-share-card:active {
  opacity: 0.85;
  transform: scale(0.97);
}

.ask-button {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 50rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 215, 0, 0.4);
  border: none;
}

.ask-button::after {
  border: none;
}

.ask-button.disabled {
  opacity: 0.6;
  background: #ccc;
  box-shadow: none;
}

/* 答案展示区域 */
.answer-section {
  animation: fadeIn 0.5s ease-in;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.answer-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.random-answer-card {
  border-left: 8rpx solid #FFD700;
}

.ai-explanation-card {
  border-left: 8rpx solid #F48FB1;
}

.card-header {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

.card-content {
  font-size: 30rpx;
  line-height: 1.8;
  color: #555;
  text-indent: 2em;
}

/* 历史记录链接 */
.history-link {
  text-align: center;
  margin-top: 30rpx;
  padding: 20rpx;
}

.history-link text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  text-decoration: underline;
}

/* 翻书动画区域 */
.book-animation {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 540rpx;
  animation: fadeIn 0.5s ease-in;
}

.book-container {
  position: relative;
  width: 520rpx;
  height: 360rpx;
  margin-bottom: 40rpx;
  perspective: 1500rpx;
}

.warm-book-aura {
  position: absolute;
  left: 50%;
  top: 48%;
  width: 560rpx;
  height: 360rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 242, 190, 0.56), rgba(255, 182, 201, 0.25) 48%, transparent 76%);
  transform: translate(-50%, -50%);
  animation: warmGlow 2.6s ease-in-out infinite;
}

.open-book {
  position: relative;
  width: 480rpx;
  height: 280rpx;
  left: 20rpx;
  top: 58rpx;
  transform-style: preserve-3d;
  transform: rotateX(58deg) rotateZ(-2deg);
  animation: bookFloat 3s ease-in-out infinite;
}

.book-base-shadow {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  bottom: -34rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(108, 40, 72, 0.26);
}

.book-half {
  position: absolute;
  top: 0;
  width: 240rpx;
  height: 278rpx;
  background: linear-gradient(115deg, #FFF8EF 0%, #FFFFFF 48%, #FFEAF2 100%);
  box-shadow:
    0 18rpx 32rpx rgba(122, 52, 83, 0.14),
    inset 0 0 0 2rpx rgba(255, 255, 255, 0.78);
  overflow: hidden;
}

.book-left {
  left: 0;
  border-radius: 24rpx 10rpx 12rpx 28rpx;
  transform-origin: right center;
  transform: rotateY(12deg);
}

.book-right {
  right: 0;
  border-radius: 10rpx 24rpx 28rpx 12rpx;
  transform-origin: left center;
  transform: rotateY(-12deg);
}

.book-half::before {
  content: '';
  position: absolute;
  top: 18rpx;
  bottom: 20rpx;
  width: 22rpx;
  border-radius: 20rpx;
  background: linear-gradient(to right, rgba(222, 146, 171, 0.16), transparent);
}

.book-left::before {
  right: 0;
}

.book-right::before {
  left: 0;
  transform: rotate(180deg);
}

.page-lines {
  position: absolute;
  left: 34rpx;
  right: 32rpx;
  top: 62rpx;
  height: 128rpx;
  background: repeating-linear-gradient(
    to bottom,
    rgba(166, 93, 120, 0.12) 0,
    rgba(166, 93, 120, 0.12) 3rpx,
    transparent 3rpx,
    transparent 25rpx
  );
}

.book-spine-light {
  position: absolute;
  left: 50%;
  top: 8rpx;
  width: 78rpx;
  height: 100%;
  transform: translateX(-50%);
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(255, 246, 184, 0.88), rgba(255, 222, 138, 0.36) 42%, transparent 72%);
  box-shadow:
    0 0 42rpx rgba(255, 240, 170, 0.78),
    0 0 96rpx rgba(255, 182, 201, 0.48);
  animation: innerLight 2.2s ease-in-out infinite;
  z-index: 8;
}

.turning-pages {
  position: absolute;
  left: 240rpx;
  top: 0;
  width: 218rpx;
  height: 276rpx;
  transform-style: preserve-3d;
  z-index: 12;
}

.turn-page {
  position: absolute;
  left: 0;
  top: 2rpx;
  width: 216rpx;
  height: 100%;
  border-radius: 8rpx 22rpx 24rpx 8rpx;
  background: linear-gradient(105deg, #FFFDF8 0%, #FFFFFF 44%, #FFEAF2 100%);
  box-shadow: 0 10rpx 20rpx rgba(126, 58, 88, 0.12);
  transform-origin: left center;
  overflow: hidden;
}

.turn-page::after {
  content: '';
  position: absolute;
  left: 32rpx;
  right: 28rpx;
  top: 66rpx;
  height: 110rpx;
  background: repeating-linear-gradient(
    to bottom,
    rgba(166, 93, 120, 0.12) 0,
    rgba(166, 93, 120, 0.12) 3rpx,
    transparent 3rpx,
    transparent 24rpx
  );
}

.turn-page-1 {
  animation: turnWarmPage 2.55s ease-in-out infinite;
  z-index: 3;
}

.turn-page-2 {
  animation: turnWarmPage 2.55s ease-in-out infinite;
  animation-delay: 0.42s;
  z-index: 2;
}

.turn-page-3 {
  animation: turnWarmPage 2.55s ease-in-out infinite;
  animation-delay: 0.84s;
  z-index: 1;
}

.light-beams {
  position: absolute;
  left: 50%;
  top: 130rpx;
  width: 320rpx;
  height: 220rpx;
  transform: translateX(-50%);
  pointer-events: none;
}

.light-beams text {
  position: absolute;
  left: 50%;
  bottom: 42rpx;
  width: 28rpx;
  height: 180rpx;
  border-radius: 999rpx;
  background: linear-gradient(to top, rgba(255, 246, 184, 0.42), transparent);
  transform-origin: bottom center;
  animation: beamSway 3s ease-in-out infinite;
}

.light-beams text:nth-child(1) {
  transform: translateX(-50%) rotate(-26deg);
}

.light-beams text:nth-child(2) {
  transform: translateX(-50%) rotate(0deg);
  animation-delay: 0.4s;
}

.light-beams text:nth-child(3) {
  transform: translateX(-50%) rotate(26deg);
  animation-delay: 0.8s;
}

.animation-text {
  max-width: 560rpx;
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
  text-align: center;
  animation: pulse 1.8s ease-in-out infinite;
  text-shadow: 0 2rpx 8rpx rgba(107, 41, 73, 0.28);
  margin-top: 30rpx;
}

.book-sparks {
  position: relative;
  width: 420rpx;
  height: 0;
}

.book-sparks text {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FFF4C4;
  box-shadow: 0 0 18rpx rgba(255, 244, 196, 0.9);
  animation: sparkRise 2.4s ease-in-out infinite;
}

.book-sparks text:nth-child(1) {
  left: 78rpx;
  animation-delay: 0s;
}

.book-sparks text:nth-child(2) {
  left: 204rpx;
  animation-delay: 0.6s;
}

.book-sparks text:nth-child(3) {
  left: 326rpx;
  animation-delay: 1.1s;
}

@keyframes bookFloat {
  0%, 100% {
    transform: translateY(0) rotateX(58deg) rotateZ(-2deg);
  }
  50% {
    transform: translateY(-10rpx) rotateX(58deg) rotateZ(-1deg);
  }
}

@keyframes turnWarmPage {
  0% {
    transform: rotateY(0deg) skewY(0deg);
    opacity: 1;
  }
  42% {
    transform: rotateY(-154deg) skewY(-2deg);
    opacity: 0.94;
  }
  54% {
    transform: rotateY(-178deg) skewY(-1deg);
    opacity: 0.72;
  }
  100% {
    transform: rotateY(-180deg) skewY(0deg);
    opacity: 0;
  }
}

@keyframes warmGlow {
  0%, 100% {
    opacity: 0.68;
    transform: translate(-50%, -50%) scale(0.96);
  }
  50% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.06);
  }
}

@keyframes innerLight {
  0%, 100% {
    opacity: 0.72;
    transform: translateX(-50%) scaleX(0.88);
  }
  50% {
    opacity: 1;
    transform: translateX(-50%) scaleX(1.16);
  }
}

@keyframes beamSway {
  0%, 100% {
    opacity: 0.34;
  }
  50% {
    opacity: 0.72;
  }
}

@keyframes sparkRise {
  0% {
    opacity: 0;
    transform: translateY(0) scale(0.6);
  }
  35% {
    opacity: 1;
  }
  100% {
    opacity: 0;
    transform: translateY(-120rpx) scale(1.2);
  }
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.7;
    transform: scale(1.05);
  }
}

/* 打字机效果 */
.typing-effect {
  position: relative;
}

.typing-effect::after {
  content: '|';
  animation: blink 0.7s infinite;
  color: #F48FB1;
  font-weight: bold;
  margin-left: 4rpx;
}

/* AI解析加载状态 */
.loading-text {
  display: block;
  text-align: center;
  font-size: 30rpx;
  color: #999;
  padding: 20rpx 0;
  animation: loadingPulse 1.5s ease-in-out infinite;
}

@keyframes loadingPulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
}

@keyframes blink {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0;
  }
}

/* 保存按钮样式 */
.share-button-wrapper {
  margin-top: 24rpx;
  padding: 0 20rpx;
}

.share-answer-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #F48FB1 0%, #F9A8C5 100%);
  border: none;
  border-radius: 44rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(244, 143, 177, 0.4);
  transition: all 0.2s ease;
}

.share-answer-btn::after {
  border: none;
}

.share-answer-btn:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 16rpx rgba(244, 143, 177, 0.3);
}

.share-icon {
  margin-right: 8rpx;
  font-size: 32rpx;
}

/* 隐藏的分享画布 */
.share-canvas-hidden {
  position: fixed;
  top: -9999rpx;
  left: -9999rpx;
  width: 750px;
  height: 1334px;
}
