<!-- subpage1/pages/reminisce/index.wxml -->
<view class="container">

  <!-- 首次访问引导：首次访问且无历史数据，数据加载完成后显示 -->
  <view class="guide-overlay" wx:if="{{showGuide}}">
    <view class="guide-content">
      <text class="guide-title">开启心情记录之旅</text>
      <text class="guide-desc">在这里，您可以记录和追踪每一天的心情变化</text>
      <text class="guide-desc">让我们开始记录第一条心情吧！</text>
      <button class="guide-btn {{tapLock === 'record' ? 'tap-disabled' : ''}}" bindtap="startRecord">开始记录</button>
    </view>
  </view>

  <!-- 用户信息头部（MVP 紧凑版 + 星座运势入口） -->
  <view class="user-header-compact {{isProfileLoaded ? 'loaded' : ''}}">
    <!-- 左侧：星座区域（点击进入运势页） -->
    <view class="constellation-section {{tapLock === 'horoscope' ? 'tap-disabled' : ''}}" bindtap="goToHoroscope">
      <text class="constellation-symbol-large">{{constellationSymbol}}</text>
      <text class="constellation-name-small">{{constellation || '设置星座'}}</text>
    </view>
    
    <!-- 右侧：昵称区域 -->
    <view class="nickname-section {{tapLock === 'edit' ? 'tap-disabled' : ''}}" bindtap="editNickname">
      <text class="nickname-text">{{nickname || '未设置昵称'}}</text>
    </view>
    
    <!-- 编辑按钮 -->
    <view class="edit-btn {{tapLock === 'edit' ? 'tap-disabled' : ''}}" bindtap="editNickname">
      <text class="edit-icon">✏️</text>
      <text class="edit-text">编辑</text>
    </view>
  </view>

  <!-- ===== 已隐藏：次数管理卡片（推广期无限使用，2026-05-21）===== -->
  <!-- <view class="usage-refactored-card">
    <view class="usage-refactored-left">
      <view class="usage-refactored-item">
        <text class="usage-refactored-label">今日赠送</text>
        <text class="usage-refactored-count">{{remainingUses}}</text>
        <text class="usage-refactored-unit">/3次</text>
      </view>
      <view class="usage-refactored-item">
        <text class="usage-refactored-label">我的库存</text>
        <text class="usage-refactored-count">{{totalUses}}</text>
        <text class="usage-refactored-unit">次</text>
      </view>
    </view>
  </view> -->

  <!-- 数据概览 -->
  <view class="overview-card">
    <text class="card-title">心情数据概览</text>
    <view class="stat-single">
      <text class="stat-value-large">{{displayTotalTimes}}</text>
      <text class="stat-label-single">条心情记录</text>
    </view>
    <button class="record-btn {{tapLock === 'record' ? 'tap-disabled' : ''}}" bindtap="goToRecord">记录此刻心情</button>
  </view>

  <!-- 情绪周报入口 -->
  <view class="weekly-report-entry {{tapLock === 'weekly' ? 'tap-disabled' : ''}}" bindtap="goToWeeklyReport">
    <view class="weekly-report-entry-left">
      <text class="weekly-report-icon">📋</text>
      <view class="weekly-report-text">
        <text class="weekly-report-title">情绪周报</text>
        <text class="weekly-report-desc">查看每周情绪体检报告</text>
      </view>
    </view>
    <text class="weekly-report-arrow">›</text>
  </view>

  <!-- 历史记录 -->
  <view class="history-section" wx:if="{{hasData && steps.length > 0}}">
    <view class="section-header">
      <text class="section-title">心情记录回顾</text>
      <text class="section-count">共 {{total}} 条</text>
    </view>
    <text class="section-desc">回顾每一个值得记录的时刻</text>
    <step-list 
      steps="{{steps}}" 
      activeIndex="{{steps.length}}" 
      bind:previewimage="onStepImagePreview"
      bind:viewdetail="onStepViewDetail"
    ></step-list>
  </view>

  <!-- 下滑提示 - 固定在屏幕右侧 -->
  <view class="scroll-hint" wx:if="{{showScrollHint}}">
    <text class="hint-text bounce">下滑回顾历史心情↓</text>
  </view>

  <!-- 加载更多提示 -->
  <view class="load-more" wx:if="{{hasData && hasMore}}">
    <text class="load-more-text">上滑加载更多</text>
  </view>

  <!-- 无更多数据提示 -->
  <view class="no-more" wx:if="{{hasData && !hasMore && steps.length > 0}}">
    <text class="no-more-text">没有更多记录了</text>
  </view>

  <!-- 图片预览 -->
  <view class="preview-modal" wx:if="{{showPreview && previewImages.length > 0}}" bindtap="hidePreview">
    <swiper class="preview-swiper" indicator-dots="{{true}}" current="{{0}}">
      <swiper-item wx:for="{{previewImages}}" wx:key="index">
        <image src="{{item}}" mode="aspectFit" class="preview-image" lazy-load="{{true}}"></image>
      </swiper-item>
    </swiper>
    <view class="preview-close" bindtap="hidePreview">关闭</view>
  </view>

  <!-- 编辑信息弹窗 -->
  <view class="modal-mask" wx:if="{{showEditModal}}" bindtap="closeEditModal">
    <view class="modal-content edit-modal" catchtap="stopPropagation">
      <text class="modal-title">编辑个人信息</text>
      
      <!-- 昵称输入 -->
      <view class="edit-field">
        <text class="edit-label">昵称</text>
        <input 
          class="edit-input" 
          placeholder="请输入昵称（最多50个字符）" 
          value="{{tempNickname}}"
          maxlength="50"
          bindinput="onNicknameInput"
        />
      </view>
      
      <!-- 星座选择 -->
      <view class="edit-field">
        <text class="edit-label">星座</text>
        <view class="constellation-selector" catchtap="showConstellationPicker">
          <text class="constellation-value">{{tempConstellation || '请选择星座'}}</text>
          <text class="selector-arrow">▼</text>
        </view>
      </view>
      
      <!-- 星座选择下拉框 -->
      <view class="constellation-dropdown" wx:if="{{showConstellationPicker}}">
        <scroll-view class="constellation-list" scroll-y>
          <view 
            class="constellation-item {{item === tempConstellation ? 'selected' : ''}}" 
            wx:for="{{constellationOptions}}" 
            wx:key="index"
            catchtap="selectConstellation"
            data-constellation="{{item}}"
          >
            <text>{{item}}</text>
          </view>
        </scroll-view>
      </view>
      
      <view class="modal-buttons">
        <button class="modal-btn cancel" bindtap="closeEditModal">取消</button>
        <button class="modal-btn confirm {{isSavingNickname ? 'tap-disabled' : ''}}" bindtap="saveProfile" disabled="{{isSavingNickname}}">{{isSavingNickname ? '保存中...' : '保存'}}</button>
      </view>
    </view>
  </view>

  <!-- 底部导航 -->
  <view class="tab-bar-placeholder"></view>
  <tab-bar currentPage="mine"></tab-bar>
</view>
