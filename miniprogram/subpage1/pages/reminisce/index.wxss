.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #F8A7C4 0%, #E879A6 100%);
  padding: 30rpx;
  padding-bottom: 200rpx;
}

/* 加载中 */
.loading-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  padding-top: 300rpx;
}

.loading-text {
  color: rgba(255, 255, 255, 0.8);
  font-size: 28rpx;
}

/* 首次访问引导 */
.guide-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.guide-content {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 60rpx 50rpx;
  text-align: center;
  margin: 0 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
}

.guide-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 30rpx;
}

.guide-desc {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

.guide-btn {
  background: linear-gradient(135deg, #F8A7C4 0%, #E879A6 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 50rpx;
  padding: 24rpx 80rpx;
  font-size: 32rpx;
  margin-top: 40rpx;
}

.guide-btn::after {
  border: none;
}

/* 空数据状态 */
.empty-wrap {
  display: flex;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-content {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 32rpx;
  padding: 60rpx 50rpx;
  text-align: center;
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.empty-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
  display: block;
  margin-bottom: 20rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
  margin-bottom: 20rpx;
}

.empty-btn {
  background: #FFFFFF;
  color: #F8A7C4;
  border: none;
  border-radius: 50rpx;
  padding: 24rpx 80rpx;
  font-size: 32rpx;
  margin-top: 30rpx;
}

.empty-btn::after {
  border: none;
}

/* 数据概览卡片 */
.overview-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.1);
}

.card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 24rpx;
}

.stat-single {
  text-align: center;
  margin-bottom: 24rpx;
}

.stat-value-large {
  font-size: 56rpx;
  font-weight: 700;
  color: #F48FB1;
  display: block;
}

.stat-label-single {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-top: 8rpx;
}

/* 星座运势入口卡片 - 沉浸式设计 */
.horoscope-entry-card {
  position: relative;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #F8A7C4 0%, #E879A6 50%, #f093fb 100%);
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(248, 167, 196, 0.4),
              0 4rpx 12rpx rgba(232, 121, 166, 0.3);
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.horoscope-entry-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.3) 0%, transparent 70%);
  border-radius: 50%;
  animation: pulse-glow 3s ease-in-out infinite;
}

@keyframes pulse-glow {
  0%, 100% { transform: scale(1); opacity: 0.5; }
  50% { transform: scale(1.2); opacity: 0.8; }
}

.horoscope-entry-card:active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 30rpx rgba(248, 167, 196, 0.3);
}

.horoscope-icon-wrap {
  position: relative;
  z-index: 1;
  width: 88rpx;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(10rpx);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.horoscope-icon {
  font-size: 52rpx;
  filter: drop-shadow(0 2rpx 8rpx rgba(0, 0, 0, 0.2));
  animation: float-star 2s ease-in-out infinite;
}

@keyframes float-star {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-6rpx) rotate(5deg); }
}

.horoscope-info {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.horoscope-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  letter-spacing: 1rpx;
}

.horoscope-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.95);
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.15);
}

.horoscope-arrow {
  position: relative;
  z-index: 1;
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-left: 16rpx;
  transition: transform 0.3s ease;
}

.horoscope-entry-card:active .horoscope-arrow {
  transform: translateX(8rpx);
}

.record-btn {
  background: linear-gradient(135deg, #F8A7C4 0%, #E879A6 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 50rpx;
  padding: 22rpx;
  font-size: 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(248, 167, 196, 0.4);
}

.record-btn::after {
  border: none;
}

/* 情绪周报入口卡片 */
.weekly-report-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(10px);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}
.weekly-report-entry:active {
  background: rgba(255, 255, 255, 0.25);
}
.weekly-report-entry-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.weekly-report-icon {
  font-size: 44rpx;
}
.weekly-report-text {
  display: flex;
  flex-direction: column;
}
.weekly-report-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFF;
}
.weekly-report-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 4rpx;
}
.weekly-report-arrow {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.5);
  font-weight: 300;
}

/* 历史记录 */
.history-section {
  padding: 0;
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  text-shadow: 0 2rpx 8rpx rgba(95, 22, 51, 0.28);
}

.section-count {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
  text-shadow: 0 2rpx 8rpx rgba(95, 22, 51, 0.24);
}

.section-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.94);
  display: block;
  margin-bottom: 24rpx;
  text-shadow: 0 2rpx 8rpx rgba(95, 22, 51, 0.22);
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx 0;
}

.load-more-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 无更多数据 */
.no-more {
  text-align: center;
  padding: 30rpx 0;
}

.no-more-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 下滑提示 - 固定在屏幕右侧 */
.scroll-hint {
  position: fixed;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 999;
  pointer-events: none;
}

.hint-text {
  font-size: 24rpx;
  color: #F48FB1;
  font-weight: 600;
  text-shadow: 0 2rpx 8rpx rgba(244, 143, 177, 0.3);
  background: rgba(255, 255, 255, 0.95);
  padding: 16rpx 12rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(244, 143, 177, 0.2);
  writing-mode: vertical-rl;
  text-orientation: upright;
  letter-spacing: 4rpx;
}

.bounce {
  animation: bounceDown 1.5s ease-in-out infinite;
}

@keyframes bounceDown {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(10rpx);
  }
}

/* 图片预览 */
.preview-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.preview-swiper {
  width: 100%;
  height: 80vh;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.preview-close {
  position: absolute;
  top: 100rpx;
  right: 30rpx;
  padding: 20rpx 40rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 30rpx;
  color: #FFFFFF;
  font-size: 28rpx;
}

/* 下滑提示文字 */
.scroll-hint {
  text-align: center;
  margin-top: 16rpx;
  padding: 16rpx 0;
  opacity: 0.6;
}

.scroll-hint-text {
  font-size: 26rpx;
  color: #F48FB1;
  font-weight: 500;
}

/* 弹跳动画 */
.bounce {
  animation: bounceDown 1.5s ease-in-out infinite;
}

@keyframes bounceDown {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(12rpx);
  }
}

/* 底部导航占位 */
.tab-bar-placeholder {
  height: 120rpx;
}

/* 次数管理卡片（参考设计图风格） */
.usage-refactored-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.usage-refactored-left {
  display: flex;
  align-items: center;
  gap: 48rpx;
  flex: 1;
}

.usage-refactored-item {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.usage-refactored-label {
  font-size: 28rpx;
  color: #999999;
  font-weight: 400;
}

.usage-refactored-count {
  font-size: 40rpx;
  font-weight: 700;
  color: #F48FB1;
  line-height: 1;
}

.usage-refactored-item:last-child .usage-refactored-count {
  color: #333333;
}

.usage-refactored-unit {
  font-size: 24rpx;
  color: #999999;
}

.usage-refactored-item:first-child .usage-refactored-unit {
  color: #F48FB1;
  font-weight: 500;
}

.usage-refactored-right {
  display: flex;
  align-items: center;
}

.usage-refactored-btn {
  font-size: 28rpx;
  color: #F48FB1;
  font-weight: 500;
  white-space: nowrap;
  cursor: pointer;
}

.usage-refactored-btn:active {
  opacity: 0.7;
}

/* 用户信息头部（MVP 紧凑版） */
.user-header-compact {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s ease;
  /* 初始状态：高度为0，透明，隐藏溢出 */
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transform: scaleY(0.8);
  transform-origin: top;
}

/* 数据加载完成后的向下展开动画 */
.user-header-compact.loaded {
  max-height: 200rpx;
  opacity: 1;
  transform: scaleY(1);
  transition: max-height 0.5s ease-out, opacity 0.5s ease-out, transform 0.5s ease-out;
}

/* 左侧：星座区域（点击进入运势页） */
.constellation-section {
  width: 140rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding-right: 24rpx;
  border-right: 2rpx solid #e0e0e0;
  cursor: pointer;
  transition: all 0.3s ease;
}

.constellation-section:active {
  opacity: 0.7;
  transform: scale(0.95);
}

.constellation-symbol-large {
  font-size: 56rpx;
  color: #F48FB1;
  font-weight: bold;
  line-height: 1;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  display: inline-block;
  min-width: 56rpx;
  text-align: center;
}

.constellation-name-small {
  font-size: 22rpx;
  color: #999;
  text-align: center;
  white-space: nowrap;
}

/* 右侧：昵称区域 */
.nickname-section {
  flex: 1;
  padding-left: 24rpx;
  min-width: 0; /* 防止内容溢出 */
  cursor: pointer;
}

.nickname-section:active {
  opacity: 0.7;
}

.nickname-text {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  word-break: break-all;
  overflow-wrap: break-word;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 编辑按钮 */
.edit-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #F48FB1 0%, #F9A8C5 100%);
  border-radius: 12rpx;
  padding: 8rpx 14rpx;
  margin-left: 12rpx;
  box-shadow: 0 3rpx 10rpx rgba(244, 143, 177, 0.3);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
  min-width: 80rpx;
}

.edit-btn:active {
  transform: scale(0.92);
  box-shadow: 0 2rpx 6rpx rgba(244, 143, 177, 0.2);
}

.edit-icon {
  font-size: 26rpx;
  margin-bottom: 2rpx;
}

.edit-text {
  font-size: 18rpx;
  color: #fff;
  font-weight: 500;
  white-space: nowrap;
  letter-spacing: 0.5rpx;
}

/* 弹窗遮罩 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  width: 600rpx;
  max-width: 90%;
}

.constellation-modal {
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-input {
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 32rpx;
}

/* 编辑信息弹窗样式 */
.edit-modal {
  max-height: 80vh;
}

.edit-field {
  margin-bottom: 28rpx;
}

.edit-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.edit-input {
  display: block;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #fff;
  text-align: left;
}

/* 星座选择器 */
.constellation-selector {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  transition: all 0.2s ease;
}

.constellation-selector:active {
  border-color: #F48FB1;
  background: #f8f7ff;
}

.constellation-value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.selector-arrow {
  font-size: 20rpx;
  color: #999;
  margin-left: 12rpx;
}

/* 星座下拉框 */
.constellation-dropdown {
  position: relative;
  margin-top: -28rpx;
  margin-bottom: 28rpx;
  background: #fff;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  max-height: 400rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  z-index: 10;
}

.constellation-list {
  flex: 1;
  max-height: 600rpx;
  margin-bottom: 32rpx;
}

.constellation-item {
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.constellation-item.selected {
  background: #F48FB1;
  color: #fff;
}

.modal-buttons {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
}

.modal-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.modal-btn.confirm {
  background: #F48FB1;
  color: #fff;
}
