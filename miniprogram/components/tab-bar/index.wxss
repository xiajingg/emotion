/* components/tab-bar/index.wxss */
/* 温暖治愈系导航栏 */
.tab-bar {
  display: flex;
  height: 120rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255,255,255,0.92);
  backdrop-filter: saturate(180%) blur(20px);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
  border-top: 1rpx solid #E8E8ED;
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 999;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #B2BEC3;
  transition: color 0.2s ease;
}

.tab-bar-item.active {
  color: #F48FB1;
}

.tab-icon-shell {
  width: 56rpx;
  height: 56rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
  background: transparent;
  transition: all 0.2s ease;
}

.tab-bar-item.active .tab-icon-shell {
  background: #FFF1F6;
  box-shadow: 0 6rpx 18rpx rgba(244, 143, 177, 0.18);
}

.tab-icon {
  font-size: 38rpx;
  line-height: 1;
}

/* 图标容器 - 相对定位 */
.tab-icon-wrapper {
  position: relative;
  display: flex;
  justify-content: center;
}

/* 红点徽章 */
.notification-badge {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
  width: 36rpx;
  height: 36rpx;
  background: #FF0000; /* 鲜艳大红色 */
  border-radius: 50%; /* 正圆形 */
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(255, 0, 0, 0.5);
  animation: badgePulse 2s ease-in-out infinite;
}

.badge-text {
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: bold;
  line-height: 1;
}

/* 红点脉冲动画 */
@keyframes badgePulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.1);
  }
}

.tab-text {
  font-size: 22rpx;
  font-weight: 500;
  margin-top: 2rpx;
}
