<!-- pages/weekly-report/weekly-report.wxml -->
<view class="page">

  <!-- Loading -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在生成你的下周情绪预案...</text>
  </view>

  <block wx:else>

    <!-- ===== 1. 头部：标题 + 周切换 + 情绪状态徽章 ===== -->
    <view class="header">
      <view class="header-glow"></view>
      <text class="header-title">📖 下周情绪预案</text>
      <!-- 周切换器 -->
      <view class="week-switcher">
        <view class="week-arrow {{isSwitchingWeek ? 'tap-disabled' : ''}}" bindtap="goToPrevWeek">◀</view>
        <text class="header-date">{{dateRange}}</text>
        <view class="week-arrow {{isSwitchingWeek ? 'tap-disabled' : ''}}" bindtap="goToNextWeek">▶</view>
      </view>
      <view class="header-badge" wx:if="{{emotionState}}">{{emotionState}}</view>
      <text class="header-decoration">每一次记录，都是对自己的温柔 📝</text>
    </view>

    <!-- ===== 订阅提示（未订阅时显示）===== -->
    <block wx:if="{{!hasSubscribed && showSubscribeBtn}}">

      <!-- ① 首次订阅：说清楚会发什么消息 -->
      <view class="card-wrap" wx:if="{{!hasEverSubscribed}}">
        <view class="subscribe-first-card">
          <view class="subscribe-first-glow"></view>
          <text class="subscribe-first-icon">🔮</text>
          <text class="subscribe-first-title">开启下周情绪预案推送</text>
          <text class="subscribe-first-desc">下周一早上 9 点，微信会为你推送一条订阅消息，包含触发点、风险场景和应对话术</text>
          <view class="subscribe-first-features">
            <text class="subscribe-feat">📊 高频触发点</text>
            <text class="subscribe-feat">⏰ 下周一早 9 点推送</text>
            <text class="subscribe-feat">💬 下周应对话术</text>
          </view>
          <button class="subscribe-first-btn {{isSubscribingWeeklyReport ? 'tap-disabled' : ''}}" bindtap="subscribeWeeklyReport" disabled="{{isSubscribingWeeklyReport}}">
            {{isSubscribingWeeklyReport ? '授权中...' : '🎁 授权订阅消息'}}
          </button>
          <text class="subscribe-first-note">* 每次授权仅对下周预案有效</text>
        </view>
      </view>

      <!-- 再次订阅：轻量提醒卡片 -->
      <view class="card-wrap" wx:else>
        <view class="subscribe-again-card">
          <view class="subscribe-again-left">
            <text class="subscribe-again-icon">📬</text>
            <text class="subscribe-again-text">上期预案已送达，下周还想收到吗？</text>
          </view>
          <button class="subscribe-again-btn {{isSubscribingWeeklyReport ? 'tap-disabled' : ''}}" bindtap="subscribeWeeklyReport" disabled="{{isSubscribingWeeklyReport}}">{{isSubscribingWeeklyReport ? '授权中...' : '授权订阅'}}</button>
        </view>
      </view>

    </block>

    <!-- ===== 3. 情绪成分分布 ===== -->
    <view class="card-wrap" wx:if="{{compositionList.length > 0}}">
      <view class="section-card">
        <view class="section-head">
          <text class="section-icon">🎨</text>
          <text class="section-title">情绪成分</text>
        </view>
        <text class="comp-summary">{{compositionSummary}}</text>
        <view class="comp-bars">
          <view class="comp-bar-row" wx:for="{{compositionList}}" wx:key="label">
            <text class="comp-label">{{item.label}}</text>
            <view class="comp-bar-track">
              <view class="comp-bar-fill" style="width:{{item.width}}; background:{{item.pct > 50 ? '#F48FB1' : item.pct > 25 ? '#F9A8C5' : '#FFE1EA'}}"></view>
            </view>
            <text class="comp-pct">{{item.pct}}%</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 4. 高光与低谷 ===== -->
    <view class="card-wrap" wx:if="{{highPoint && highPoint.date}}">
      <view class="dual-cards">
        <!-- 高光 -->
        <view class="hl-card card-high" wx:if="{{highPoint.date}}">
          <text class="hl-emoji">☀️</text>
          <text class="hl-label">最高光的一天</text>
          <text class="hl-date">{{highPoint.dayOfWeek}} {{highPoint.date}}</text>
          <text class="hl-tag">{{highPoint.emotion}}</text>
          <text class="hl-text">"{{highPoint.inputText}}"</text>
        </view>
        <!-- 低谷 -->
        <view class="hl-card card-low" wx:if="{{lowPoint.date && lowPoint.date !== highPoint.date}}">
          <text class="hl-emoji">🌧️</text>
          <text class="hl-label">最低谷的一天</text>
          <text class="hl-date">{{lowPoint.dayOfWeek}} {{lowPoint.date}}</text>
          <text class="hl-tag">{{lowPoint.emotion}}</text>
          <text class="hl-text">"{{lowPoint.inputText}}"</text>
        </view>
      </view>
    </view>

    <!-- ===== 6. 周环比 ===== -->
    <view class="card-wrap" wx:if="{{weekComparison.hasLastWeek}}">
      <view class="section-card">
        <view class="section-head">
          <text class="section-icon">📊</text>
          <text class="section-title">周环比</text>
          <view class="compare-arrow {{weekComparison.scoreDelta > 0 ? 'arrow-up' : weekComparison.scoreDelta < 0 ? 'arrow-down' : 'arrow-flat'}}">
            <text>{{weekComparison.scoreDelta > 0 ? '↑' : weekComparison.scoreDelta < 0 ? '↓' : '→'}} {{weekComparison.scoreDelta > 0 ? '+' : ''}}{{weekComparison.scoreDelta}}</text>
          </view>
        </view>
        <view class="compare-row">
          <view class="compare-col">
            <text class="compare-week">上周</text>
            <text class="compare-val">{{weekComparison.avgScore}}分</text>
            <text class="compare-sub">{{weekComparison.mainTag}} · {{weekComparison.recordCount}}次</text>
          </view>
          <view class="compare-vs">→</view>
          <view class="compare-col">
            <text class="compare-week">本周</text>
            <text class="compare-val">{{averageScore}}分</text>
            <text class="compare-sub">{{mainTag}} · {{recordCount}}次</text>
          </view>
        </view>
        <text class="compare-text">{{weekComparison.trendText}}</text>
      </view>
    </view>

    <!-- ===== 7. 情绪触发点 ===== -->
    <view class="card-wrap" wx:if="{{triggers.length > 0}}">
      <view class="section-card">
        <view class="section-head">
          <text class="section-icon">🔍</text>
          <text class="section-title">影响你情绪的事情</text>
        </view>
        <view class="trigger-list">
          <view class="trigger-item" wx:for="{{triggers}}" wx:key="category">
            <view class="trigger-head">
              <text class="trigger-cat">{{item.category}}</text>
              <text class="trigger-impact impact-{{item.impact}}">
                {{item.impact === 'positive' ? '😊 正向' : item.impact === 'negative' ? '😔 负向' : '😐 中性'}}
              </text>
              <text class="trigger-score">{{item.avgScore}}分</text>
            </view>
            <text class="trigger-desc">{{item.description}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 8. AI 深度洞察 ===== -->
    <view class="card-wrap" wx:if="{{aiInsight}}">
      <view class="section-card insight-card">
        <view class="section-head">
          <text class="section-icon">🧠</text>
          <text class="section-title">本周高频触发点</text>
        </view>
        <text class="insight-text">{{aiInsight}}</text>
      </view>
    </view>

    <!-- ===== 9. AI 治愈点评 ===== -->
    <view class="card-wrap" wx:if="{{aiCommentary}}">
      <view class="comment-card">
        <view class="comment-icon-wrap">💬</view>
        <text class="comment-title">专属治愈点评</text>
        <text class="comment-text">{{aiCommentary}}</text>
      </view>
    </view>

    <!-- ===== 10. 针对性建议 ===== -->
    <view class="card-wrap" wx:if="{{suggestionList.length > 0}}">
      <view class="section-card">
        <view class="section-head">
          <text class="section-icon">💡</text>
          <text class="section-title">下周具体预案</text>
        </view>
        <view class="suggestion-list">
          <view class="sug-item" wx:for="{{suggestionList}}" wx:key="*this">
            <text>{{item}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 11. 下周风险场景 ===== -->
    <view class="card-wrap" wx:if="{{nextWeekForecast.riskLevel}}">
      <view class="section-card forecast-card" style="border-color:{{forecastRiskColor}}">
        <view class="section-head">
          <text class="section-icon">🔮</text>
          <text class="section-title">下周风险场景</text>
          <view class="forecast-risk" style="background:{{forecastRiskColor}}">
            {{nextWeekForecast.riskLevel === 'high' ? '⚠️ 高风险' : nextWeekForecast.riskLevel === 'medium' ? '⚡ 中风险' : '✅ 低风险'}}
          </view>
        </view>
        <view class="forecast-detail">
          <view class="fore-row" wx:if="{{nextWeekForecast.riskDays}}">
            <text class="fore-label">风险日</text>
            <text class="fore-val">{{nextWeekForecast.riskDays}}</text>
          </view>
          <view class="fore-row" wx:if="{{nextWeekForecast.peakDay}}">
            <text class="fore-label">峰值日</text>
            <text class="fore-val">{{nextWeekForecast.peakDay}}</text>
          </view>
          <view class="fore-row" wx:if="{{nextWeekForecast.peakHint}}">
            <text class="fore-label">趋势提示</text>
            <text class="fore-val">{{nextWeekForecast.peakHint}}</text>
          </view>
        </view>
        <text class="fore-suggestion" wx:if="{{nextWeekForecast.suggestion}}">💬 {{nextWeekForecast.suggestion}}</text>
      </view>
    </view>

    <!-- ===== 12. 成就徽章 ===== -->
    <view class="card-wrap" wx:if="{{badges.length > 0}}">
      <view class="badge-row">
        <text class="badge-item" wx:for="{{badges}}" wx:key="*this">{{item}}</text>
      </view>
    </view>

    <!-- ===== 13. 底部操作 ===== -->
    <view class="actions">
      <button class="act-btn act-primary {{isGeneratingPoster ? 'tap-disabled' : ''}}" bindtap="handleShareCard" disabled="{{isGeneratingPoster}}">{{isGeneratingPoster ? '生成中...' : '🎨 分享给朋友'}}</button>
    </view>

    <view class="bottom-spacer"></view>

  </block>

  <canvas type="2d" id="posterCanvas" class="poster-hidden" style="width:375px;height:700px;"></canvas>

</view>
