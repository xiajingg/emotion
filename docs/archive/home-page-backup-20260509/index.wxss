/* pages/home/index.wxss */
/* 复用温暖治愈系全局样式 */

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FAFAFA 0%, #F0F0FF 100%);
  display: flex;
  flex-direction: column;
}

.content-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 40rpx 32rpx;
}

/* ---- 头部 ---- */
.header-section {
  text-align: center;
  margin-bottom: 48rpx;
  animation: fadeIn 0.6s ease-out both;
}

.logo {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.logo-icon {
  font-size: 48rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #6C5CE7;
  letter-spacing: -1rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #636E72;
  margin: 8rpx 0 0;
  font-weight: 400;
}

/* ---- 心语卡片 ---- */
.quote-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(108,92,231,0.08);
  animation: slideUp 0.4s cubic-bezier(0.175,0.885,0.32,1.275) 0.1s both;
}

.quote-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.quote-icon {
  font-size: 32rpx;
}

.quote-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D3436;
}

.quote-content {
  margin-bottom: 32rpx;
  min-height: 60rpx;
}

.quote-text {
  font-size: 32rpx;
  line-height: 1.7;
  color: #2D3436;
  text-align: center;
}

.quote-footer {
  display: flex;
  justify-content: center;
}

.feedback-section {
  display: flex;
  align-items: center;
  gap: 40rpx;
}

.feedback-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: rgba(108,92,231,0.08);
  border-radius: 9999rpx;
  transition: all 0.2s ease;
}

.feedback-btn:active {
  background: rgba(108,92,231,0.15);
  transform: scale(0.95);
}

.feedback-icon {
  font-size: 28rpx;
}

.feedback-count {
  font-size: 24rpx;
  font-weight: 600;
  color: #6C5CE7;
}

/* ---- 进入区域 ---- */
.enter-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 48rpx;
  animation: slideUp 0.4s cubic-bezier(0.175,0.885,0.32,1.275) 0.2s both;
}



.enter-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  max-width: 640rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #6C5CE7 0%, #A29BFE 100%);
  color: #FFFFFF;
  border-radius: 9999rpx;
  box-shadow: 0 4rpx 16rpx rgba(108,92,231,0.25);
  transition: all 0.2s ease;
}

.enter-btn:active {
  opacity: 0.85;
  transform: scale(0.97);
}

.btn-icon { font-size: 32rpx; }
.btn-text { font-size: 32rpx; font-weight: 600; letter-spacing: -0.5rpx; }
.btn-arrow { font-size: 32rpx; transition: transform 0.3s ease; }

/* ---- 动画 ---- */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}
